{
  "compilerOptions": {
    "target": "es2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["es2019", "dom", "DOM.Iterable"],
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "vitest.config.ts"]
}
