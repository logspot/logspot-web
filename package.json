{
  "name": "@logspot/web",
  "version": "5.4.1",
  "description": "Logspot Web SDK",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logspot/logspot-web.git"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy": "pnpm typecheck && pnpm test && pnpm build && pnpm publish --access public"
  },
  "author": "Logspot",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "jsdom": "30.1.1",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "files": [
    "dist"
  ]
}
